# ---------------------------------------------------------------------------
# EchipaMea backend configuration
#
# Copy to `.env` for local development. `src/common/config/env.schema.ts`
# validates every value at boot and refuses to start on a bad config.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# Comma-separated allowlist, or `*` in development only.
CORS_ORIGINS=*

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://echipamea:echipamea@localhost:5432/echipamea?schema=public

# --- JWT -------------------------------------------------------------------
# RS256 is the default and is what production should use: the realtime layer
# and any future service can verify tokens without holding the signing key.
# HS256 exists so `docker compose up` works without generating a key pair.
JWT_ALG=HS256
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
# Used when JWT_ALG=RS256. PEM, newlines escaped as \n.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=echipamea-api
JWT_AUDIENCE=echipamea-app

# Access-token lifetimes. Workers get a long one because a token expiring
# mid-shift would mean re-scanning a QR code on a roof.
JWT_FOREMAN_ACCESS_TTL=60m
JWT_WORKER_ACCESS_TTL=12h
REFRESH_FOREMAN_TTL_DAYS=30
REFRESH_WORKER_TTL_DAYS=7

# --- Worker QR login tickets ----------------------------------------------
WORKER_LOGIN_TICKET_TTL_SECONDS=90
# Optional deep link used to build `qrPayloadUrl`. Leave empty to emit raw JSON only.
APP_WORKER_LOGIN_URL=

# --- Realtime --------------------------------------------------------------
REALTIME_TICKET_TTL_SECONDS=60
REALTIME_HEARTBEAT_INTERVAL_MS=30000
# Accept a raw access token in the WS query string. Convenient, but query
# strings land in proxy access logs -- prefer `?ticket=` from POST /realtime/tickets.
REALTIME_ACCESS_TOKEN_IN_QUERY=true

# --- Migration transition flags -------------------------------------------
# The Flutter client currently sends no Authorization header and no WS auth.
# These keep it working until it is rewired. The config schema refuses to boot
# with NODE_ENV=production and any of these true, unless the override below is set.
ALLOW_ANONYMOUS_WORKER_REPORTS=true
REALTIME_ALLOW_ANONYMOUS=true
# Company that anonymous traffic is attributed to while the flags above are on.
# Required as soon as more than one company exists: with several tenants and no
# value here the server cannot tell which one an unauthenticated caller means,
# so it rejects the request and the flags above appear to do nothing.
DEFAULT_COMPANY_ID=demo-company
I_ACCEPT_INSECURE_TRANSITION=false

# Allow phase submit/review from any state, matching today's client behaviour.
# Turn off to enforce the strict state machine.
PHASE_TRANSITIONS_LENIENT=true

# --- Storage ---------------------------------------------------------------
# `local` writes to STORAGE_LOCAL_DIR; `s3` targets any S3-compatible service.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=echipamea
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900

# --- Upload limits ---------------------------------------------------------
UPLOAD_MAX_FILE_BYTES=26214400
UPLOAD_MAX_FILES=20

# --- Retention -------------------------------------------------------------
LOCATION_SAMPLE_RETENTION_DAYS=90

# --- Seeding ---------------------------------------------------------------
# Inserts the demo tenant with the literal ids the Flutter app and its tests use
# (c1/c2/c3, e1/e2/e3, p1/p2/p3). Never enable in production.
SEED_DEMO=true
SEED_FOREMAN_EMAIL=foreman@echipamea.local
SEED_FOREMAN_PASSWORD=foreman123

LOG_LEVEL=debug
